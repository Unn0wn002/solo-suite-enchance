# Next.js build-time environment variables (loaded from a gitignored
# .env.local during `vinext dev` / `vinext build` — see vite.config.ts's own
# comment: "application environment belongs in ignored .env* files").
#
# Copy this file to .env.local and fill in real values. Do NOT commit
# .env.local — only this .example file is tracked (see .gitignore).
#
# For Cloudflare Worker runtime bindings/vars (as opposed to Next.js
# build-time vars), see .dev.vars.example instead — they use a different
# mechanism and are NOT read from this file.

# The site's own canonical production URL. Used for metadataBase, Open Graph,
# Twitter card, robots.txt's Sitemap: line, and sitemap.xml (app/layout.tsx,
# app/robots.ts, app/sitemap.ts). If unset, silently falls back to
# http://localhost:3000 — which is wrong in production and was flagged as a
# risk in the 2026-08-07 audit (.solo/risks.md). Set this for every real
# deploy target.
NEXT_PUBLIC_SITE_URL=https://example.com
